APP_NAME="FoodieGo Backend"
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=foodiego_db

DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/foodiego_db

JWT_SECRET_KEY=CHANGE_THIS_SECRET_KEY_MIN_32_CHARS_LONG_FOR_SECURITY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_URL=http://localhost:5173
